{
  "name": "@goblins/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=local.env --env-file-if-exists=../../.env.local ./node_modules/vite/bin/vite.js dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.7.1",
    "@electric-sql/client": "^1.5.28",
    "@goblins/domain": "workspace:*",
    "@goblins/templates": "workspace:*",
    "@goblins/ui": "workspace:*",
    "@tanstack/electric-db-collection": "^0.6.1",
    "@tanstack/react-db": "0.5.10",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.2",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.1",
    "drizzle-orm": "~0.45.4",
    "effect": "^3.22.2",
    "katex": "^0.19.0",
    "nitro": "3.0.260610-beta",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
