    "@goblins/simulator": "workspace:*",
    "@goblins/templates": "workspace:*",
    "drizzle-orm": "~0.45.4",
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
