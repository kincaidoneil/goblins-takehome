# Copy to .env.local at the repo root and fill in. Never commit .env.local.
# docs/setup.md says where each value comes from.

# Filled by Kincaid
OPENROUTER_API_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEON_API_KEY=

# Filled by agents into .env.development.local (not this file) with
# `vercel env pull .env.development.local`. A pull overwrites its target file,
# so it must never point at .env.local. Vite loads both files in dev.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Electric. Production values are set on Vercel by infra/electric/deploy.sh.
# Locally, apps/web/local.env points at the Docker Electric.
ELECTRIC_URL=
ELECTRIC_SECRET=

# Model selection. Real OpenRouter calls only when this is "openrouter".
MODEL_CLIENT=mock

# Grading queue: Upstash QStash, set on Vercel by the Marketplace integration
# (shared iad1 resource). The app uses QStash in production, or anywhere with
# GRADER_QUEUE=qstash (e.g. QStash's local dev server for the load test).
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
GRADER_QUEUE=
GRADER_CONSUMER_URL=
GRADER_PARALLELISM=10

# Vercel cron sends `Authorization: Bearer $CRON_SECRET` to the stuck-grade
# sweeper (/api/grading/sweep); without it the sweeper answers 401 and stuck grades
# are never resent. Any random string, set on Vercel for every environment.
CRON_SECRET=
